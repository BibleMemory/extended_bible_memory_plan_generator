{{!< default}}

{{!--
  Bible Memory Plan Generator — Ghost Theme Custom Page Template

  A full-width page template for displaying the Bible memory plan widget.

  Installation:
  1. Copy this file into the root of your Ghost theme, alongside default.hbs
     (do not overwrite default.hbs — this template extends it via {{!< default}}).
  2. In the Ghost Admin panel, create a page whose slug is "memory-plan";
     Ghost applies page-{slug}.hbs to it automatically. To choose the template
     from the dropdown in page settings instead, rename this file to
     custom-memory-plan.hbs (only custom-*.hbs templates appear in that picker).

  CSS Asset Paths:
  - If hosting the bundle in your theme's assets/built/ directory:
    Copy dist/bible-memory-plan.min.js to assets/built/bible-memory-plan.min.js
    (The <link> tag below references it via {{asset}})
  - Alternatively, use the jsDelivr CDN URL as shown in the commented line

  Both approaches work; CDN is recommended for simplicity (no manual updates).
--}}

{{#post}}
<article class="post">
  <header class="post-header">
    <h1 class="post-title">{{title}}</h1>
  </header>

  <section class="post-content">
    {{content}}

    {{!-- The widget mount point --}}
    <div data-bible-memory-plan></div>
  </section>
</article>

{{!-- Option A: Load from theme assets/built/ directory --}}
{{!-- <script src="{{asset 'built/bible-memory-plan.min.js'}}" defer></script> --}}

{{!-- Option B: Load from CDN (recommended) --}}
<script src="https://cdn.jsdelivr.net/gh/Jeeves-and-Company/ghost_bible_memory_plan_generator@v1.0.0/dist/bible-memory-plan.min.js" defer></script>

{{/post}}
